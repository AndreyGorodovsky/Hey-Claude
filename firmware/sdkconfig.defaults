# Build configuration, committed to the repository.
#
# ESP-IDF keeps its full configuration in a generated file, `sdkconfig`, which
# is not committed (it can end up holding local values). On the first build,
# and whenever `sdkconfig` is deleted, it is created from ESP-IDF's defaults
# with the values below applied on top. After changing this file, delete
# `sdkconfig` so the change takes effect.
#
# Holds no credentials: WiFi and device settings are entered at runtime
# through the serial console (see README).

CONFIG_IDF_TARGET="esp32s3"

# --- Flash and partitions ---
# 16 MB flash chip. QIO ("quad I/O") reads flash over four data lines instead
# of two, roughly doubling the speed of code running from flash. The build
# still marks the image as DIO; the bootloader switches to QIO itself.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# Use the project's own partition table, partitions.csv, instead of a default.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- PSRAM ---
# 8 MB of extra RAM inside the chip package (the "R8" in ESP32-S3R8),
# connected over an eight-line ("octal") bus. Must be enabled here or the
# firmware cannot use it. Its free size is logged at every boot.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# --- CPU ---
# Full speed; the default is 160 MHz. Audio and wake-word work need it.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- Brownout detector ---
# Resets the chip if the supply voltage drops too low, and records the reason.
# That record is how supply faults are spotted (KNOWN-ISSUES R2, R9).
CONFIG_ESP_BROWNOUT_DET=y

# --- Core dump ---
# On a crash, save the state of every task to the `coredump` partition. It
# survives the reboot and can be read with: idf.py coredump-info
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# --- Logging ---
# Log level compiled in: errors, warnings and informational messages.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Display: LVGL graphics library ---
# The panel's controller. Also brings in LVGL's generic driver for MIPI-style
# controllers, which the NV3007 driver is built on.
CONFIG_LV_USE_NV3007=y
# Draw in RGB565 with each pixel's bytes in the order the panel expects
# (high byte first), so no conversion pass is needed before sending.
CONFIG_LV_COLOR_FORMAT_RGB565_SWAPPED=y
# LVGL allocates its objects with the C library's malloc, from the normal
# heap, instead of reserving a fixed 64 KB pool of internal RAM of its own.
CONFIG_LV_USE_CLIB_MALLOC=y
# Fonts: the 14 px default for small text, 28 px for titles.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_28=y
# LVGL's warnings and errors go to the log (display.c forwards them).
CONFIG_LV_USE_LOG=y
# LVGL's bundled examples and demos are not needed in the firmware.
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
