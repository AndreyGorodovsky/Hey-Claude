# Committed build configuration. Holds no credentials: WiFi and device
# settings are entered at runtime through the serial console (see README).

CONFIG_IDF_TARGET="esp32s3"

# Flash and partitions
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# In-package 8 MB octal PSRAM (ESP32-S3R8)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Brownout resets must stay visible in the reset reason (R2, R9)
CONFIG_ESP_BROWNOUT_DET=y

# A crash is saved to flash and survives the reboot; read it with
# idf.py coredump-info
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
