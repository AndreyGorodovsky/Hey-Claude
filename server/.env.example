# Hey Claude server configuration.
#
# Copy this file to `.env` in the same directory and fill in the values.
# `.env` is gitignored and must never be committed. This file is committed,
# so every value here must remain empty or a non-sensitive default.
#
# See SECRETS.md at the repository root.

# --- Credentials (required, no defaults) ---

# Anthropic Console -> Settings -> API keys.
# Create inside a dedicated workspace, with full access (not read-only) and a
# per-key spend limit. Do not use an Admin API key.
ANTHROPIC_API_KEY=

# Deepgram Console -> Settings -> API Keys.
# Create with the Member role. Set an expiry date.
DEEPGRAM_API_KEY=

# Device identifier -> token, as one JSON object on one line, for example
# {"kitchen":"<token>"}. A token is a device's password to this server; each
# must be 24 to 64 characters, and an identifier at most 32. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# With no entry, no device can connect.
DEVICE_TOKENS={}

# --- Transport ---
BIND_HOST=0.0.0.0
BIND_PORT=8765
# Advertise the server on the local network, so devices find it by mDNS.
MDNS_ENABLED=true

# --- Conversation ---
# IANA timezone name, e.g. Europe/Berlin. Determines when the daily
# conversation rolls over. Left as UTC here because a real location is
# personal information and this file is public.
TIMEZONE=UTC
DAY_ROLLOVER_HOUR=4
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=8000

# --- Speech ---
STT_MODEL=nova-3
STT_LANGUAGE=en
TTS_MODEL=aura-2-thalia-en
# Milliseconds of silence that end an utterance.
ENDPOINTING_MS=400
# Seconds to wait for the first word after the wake word.
NO_SPEECH_TIMEOUT_SECONDS=5

# --- Storage ---
# Contains transcripts and conversation history. Keep outside version control.
DB_PATH=data/hey_claude.sqlite3

# --- Audio ---
PLAYBACK_SAMPLE_RATE=24000
# Seconds before the server stops a request that has not ended. Must stay
# below the device's own limit of 15.
MAX_CAPTURE_SECONDS=13

# --- Logging ---
LOG_LEVEL=INFO

# Transcripts are personal data. Enable only for local debugging, and never
# where logs are retained, shipped or shared.
LOG_TRANSCRIPTS=false
